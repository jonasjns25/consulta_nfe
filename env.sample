PORT=3008

# ============================================
# CONFIGURAÇÃO DE MÚLTIPLOS SERVIDORES
# ============================================
SERVERS=servidor1,servidor2

SERVER_servidor1_NAME=Servidor Principal
SERVER_servidor1_HOST=127.0.0.1
SERVER_servidor1_USER=root
SERVER_servidor1_PASSWORD=root
SERVER_servidor1_DATABASE=sac
SERVER_servidor1_CONNECTION_LIMIT=5

SERVER_servidor2_NAME=Servidor Secundário
SERVER_servidor2_HOST=192.168.1.100
SERVER_servidor2_USER=root
SERVER_servidor2_PASSWORD=root
SERVER_servidor2_DATABASE=sac
SERVER_servidor2_CONNECTION_LIMIT=5

DEFAULT_SERVER=servidor1

# Login usa a senha do ERP (tabela funciona) do servidor escolhido na tela.
# Cada servidor SAC tem usuários e senhas próprios — a senha do servidor A não vale no B.

# Legado (compatibilidade)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=root
DB_NAME=sac
DB_CONNECTION_LIMIT=5

DANFE_API_KEY=
DANFE_API_URL=https://api.meudanfe.com.br/v2

# ============================================
# Banco ConfNF (pode ser outro servidor / outro MySQL)
# Se CONFNF_HOST estiver vazio, usa o mesmo MySQL do SAC (schema confnf).
# ============================================
CONFNF_HOST=192.168.1.50
CONFNF_PORT=3306
CONFNF_USER=confnf
CONFNF_PASSWORD=senha_confnf
CONFNF_DB_NAME=confnf
CONFNF_CONNECTION_LIMIT=5
# CONFNF_JWT_SECRET=confnf-dev-secret
# CONFNF_SESSION_HOURS=8

# Login da tela Lumi NF-e (mesma senha/matrícula do ERP SoftLumi)
# A senha é a do cadastro em funciona.SENHA naquele servidor SAC.
# AUTH_JWT_SECRET=lumi-nfe-auth
# AUTH_SESSION_HOURS=8
# AUTH_ENCODE_KEY=papafila

# Só os botões Manutenção XML, Autorizar recepção e Aplicar Ações em Massa.
# Vazio = todos veem. Com códigos = só essas matrículas veem e usam esses 3 botões.
# NFE_ALTERAR_MATRICULAS=0000558,0000132

# ============================================
# Observação / classificação na listagem de NF-e
# NFE_OBS_ATIVO=1 exibe o campo na pesquisa. Lista separada por | ou ;
# ============================================
# NFE_OBS_ATIVO=1
# NFE_OBS_LISTA=BONIFICAÇÃO S/ PEDIDO (EMAIL ENVIADO)|CANCELADA|CONSUMO INTERNO|DEVOLUÇÃO DE VENDA|DEVOLUÇÃO INTERNA|DEVOLUÇÃO TOTAL|DIVERGÊNCIA NO PEDIDO (VALOR MAIOR)|DIVERGÊNCIA NO PEDIDO (CONDIÇÃO DE PAGAMENTO)|DIVERGÊNCIA NO PEDIDO (QUANTIDADE)|LANÇADA|NF INCORRETA|SEM PEDIDO (EMAIL ENVIADO)|SERÁ CANCELADA|TRANSF.INSUMO P/ PRODUCAO ROTISSERIA|TROCA PRODUTO IMPROPRIO

# ============================================
# Certificado SEFAZ (consulta XML / status)
# ============================================
# Preferencial: arquivo .pfx exportável (evita erro "chave privada não exportável" do Windows).
# SEFAZ_PFX_PATH e SEFAZ_PFX_PASS precisam vir juntos — senha vazia faz a consulta falhar.
# Se o Node/PM2 roda como serviço, importe o A1 em Local Computer (não só no usuário logado).
# SEFAZ_PFX_PATH=C:\consulta_nfe\Certificados\meu_certificado.pfx
# SEFAZ_PFX_PASS=senha_do_certificado
# Por CNPJ do estabelecimento (opcional):
# SEFAZ_PFX_PATH_15589854000122=C:\caminho\cert.pfx
# SEFAZ_PFX_PASS_15589854000122=senha
# Também aceita .pfx na pasta Certificados\ com o CNPJ no nome do arquivo.
# SEFAZ_TPAMB=1

# ============================================
# Auto-update (GitHub Releases)
# ============================================
# Politica de segredos / atualizações seguras do cliente: veja SECURITY.md
UPDATE_REPO_OWNER=SEU_USUARIO_GITHUB
UPDATE_REPO_NAME=consulta_nfe
UPDATE_ASSET_NAME=consulta_nfe.zip
UPDATE_TOKEN=
UPDATE_AUTO=true
UPDATE_INTERVAL_H=6
UPDATE_ADMIN_TOKEN=
# Por padrao, a UI rodando na propria LAN do cliente pode disparar update sem token.
# Para exigir UPDATE_ADMIN_TOKEN em todas as chamadas (incluindo localhost), use:
# UPDATE_REQUIRE_TOKEN=true
UPDATE_REQUIRE_TOKEN=
