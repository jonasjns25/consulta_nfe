PORT=3008

# ============================================
# CONFIGURAÇÃO DE MÚLTIPLOS SERVIDORES
# ============================================
SERVERS=servidor1,servidor2

SERVER_servidor1_NAME=Servidor Principal
SERVER_servidor1_HOST=127.0.0.1
SERVER_servidor1_USER=root
SERVER_servidor1_PASSWORD=root
SERVER_servidor1_DATABASE=sac
SERVER_servidor1_CONNECTION_LIMIT=5

SERVER_servidor2_NAME=Servidor Secundário
SERVER_servidor2_HOST=192.168.1.100
SERVER_servidor2_USER=root
SERVER_servidor2_PASSWORD=root
SERVER_servidor2_DATABASE=sac
SERVER_servidor2_CONNECTION_LIMIT=5

DEFAULT_SERVER=servidor1

# Legado (compatibilidade)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=root
DB_NAME=sac
DB_CONNECTION_LIMIT=5

DANFE_API_KEY=
DANFE_API_URL=https://api.meudanfe.com.br/v2

# ============================================
# Auto-update (GitHub Releases)
# ============================================
# Politica de segredos / atualizações seguras do cliente: veja SECURITY.md
UPDATE_REPO_OWNER=SEU_USUARIO_GITHUB
UPDATE_REPO_NAME=consulta_nfe
UPDATE_ASSET_NAME=consulta_nfe.zip
UPDATE_TOKEN=
UPDATE_AUTO=true
UPDATE_INTERVAL_H=6
UPDATE_ADMIN_TOKEN=
# Por padrao, a UI rodando na propria LAN do cliente pode disparar update sem token.
# Para exigir UPDATE_ADMIN_TOKEN em todas as chamadas (incluindo localhost), use:
# UPDATE_REQUIRE_TOKEN=true
UPDATE_REQUIRE_TOKEN=
